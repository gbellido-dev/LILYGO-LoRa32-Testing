// Clave AES-128 del enlace LoRa: la MISMA en las dos placas.
// ¡Cámbiala! Genera una con:
//   python3 -c "import os;print(', '.join(f'0x{b:02x}' for b in os.urandom(16)))"
// Con la clave de ejemplo el OLED avisa "CLAVE DE EJEMPLO".
#define LORA_KEY { 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, \
                   0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff }
