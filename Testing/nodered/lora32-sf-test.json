  {
    "id": "f1f0000000000002",
    "type": "function",
    "name": "resumen por SF",
    "func": "// Guarda el último resumen de cada SF y regenera tabla y gráficas\nconst s = msg.payload;\nconst all = flow.get('summary') || {};\nall['SF' + s.sf] = s;\nflow.set('summary', all);\n\nconst r1 = v => v === undefined ? null : Math.round(v * 10) / 10;\nconst pct = v => Math.round((v || 0) * 1000) / 10;\nconst keys = Object.keys(all).sort((a, b) => all[a].sf - all[b].sf);\n\nconst table = keys.map(k => {\n    const x = all[k];\n    return {\n        SF: x.sf,\n        'ToA ms': x.toa_ms,\n        'Enviados': x.sent,\n        'Oídos': x.garage_rx,\n        'Pongs': x.pongs,\n        '% ↑': pct(x.pdr_up),\n        '% ↓': pct(x.pdr_dn),\n        '% ida+vuelta': pct(x.pdr_rt),\n        'RSSI ↑': r1(x.rssi_up_all ?? x.rssi_up),\n        'SNR ↑': r1(x.snr_up_all ?? x.snr_up),\n        'RSSI ↓': r1(x.rssi_dn),\n        'SNR ↓': r1(x.snr_dn),\n        'RTT ms': x.rtt_ms ? Math.round(x.rtt_ms) : null\n    };\n});\n\nconst pdr = [];\nconst lvl = [];\nconst snr = [];\nfor (const k of keys) {\n    const x = all[k];\n    pdr.push({ sf: k, serie: 'casa→garaje', v: pct(x.pdr_up) });\n    pdr.push({ sf: k, serie: 'garaje→casa', v: pct(x.pdr_dn) });\n    pdr.push({ sf: k, serie: 'ida+vuelta', v: pct(x.pdr_rt) });\n    if (x.pongs) {\n        lvl.push({ sf: k, serie: '↓ garaje→casa', v: r1(x.rssi_dn) });\n        lvl.push({ sf: k, serie: '↑ casa→garaje', v: r1(x.rssi_up_all ?? x.rssi_up) });\n        snr.push({ sf: k, serie: '↓ garaje→casa', v: r1(x.snr_dn) });\n        snr.push({ sf: k, serie: '↑ casa→garaje', v: r1(x.snr_up_all ?? x.snr_up) });\n    }\n}\n\n// Línea CSV\nconst cols = ['sweep','test','sf','bw','cr','power','freq','toa_ms','interval_ms','cfg_ok','report_ok','aborted',\n              'sent','garage_rx','pongs','pdr_up','pdr_dn','pdr_rt','rssi_up','snr_up','rssi_up_all','snr_up_all',\n              'rssi_dn','snr_dn','rssi_dn_min','snr_dn_min','rtt_ms','ctrl_rssi'];\nlet csv = '';\nif (!context.get('hdr')) { csv += 'fecha,' + cols.join(',') + '\\n'; context.set('hdr', true); }\ncsv += new Date().toISOString() + ',' + cols.map(c => s[c] ?? '').join(',');\n\nreturn [{ payload: table }, { payload: pdr }, { payload: lvl }, { payload: csv }, { payload: snr }];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 320,
