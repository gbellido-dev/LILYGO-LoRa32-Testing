    "id": "e1f0000000000004",
    "type": "function",
    "name": "evento barrido",
    "func": "const p = msg.payload;\nconst sf = (p.sf || []).join(',');\nconst txt = p.event === 'start' ? `En curso (SF ${sf}, ${p.count} pings, ${p.power} dBm)`\n          : p.event === 'end' ? 'Terminado' : 'Parado';\nconst out = [{ payload: txt }, null];\nif (p.event === 'start') out[1] = { payload: [] };   // limpia gráficas de pings\nreturn out;",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
