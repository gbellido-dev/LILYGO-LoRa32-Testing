  {
    "id": "e1f0000000000011",
    "type": "function",
    "name": "formulario → orden",
    "func": "const f = msg.payload;\nflow.set('form', f);   // recordar últimos valores\nconst sf = String(f.sf).split(/[ ,;]+/).map(Number).filter(v => v >= 6 && v <= 12);\nif (!sf.length) { node.warn('SF no válidos'); return null; }\nmsg.payload = {\n    action: 'start', sf,\n    count: Number(f.count) || 20,\n    power: Number(f.power) || 14,\n    bw: Number(f.bw) || 125,\n    cr: Number(f.cr) || 5,\n    loop: !!f.loop\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
